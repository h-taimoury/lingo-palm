# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
# Render adds RENDER_EXTERNAL_HOSTNAME automatically. Add any custom hosts here.
ALLOWED_HOSTS=
# Copy the PostgreSQL URL from Neon into Render's environment, keeping SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Use your exact Vercel origin. No trailing slash and no wildcard.
# Browser API requests must use a same-origin proxy on the Vercel frontend.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://lingo-palm-frontend.vercel.app

JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
# JWT_COOKIE_PATH=/
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
